# Copy file nay thanh .env neu muon doi gia tri mac dinh.
# Khong co .env thi docker compose van chay duoc bang cac default ben duoi.

MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=drink_order_db

# Port MySQL mo ra host. Doi neu 3307 da bi chiem.
MYSQL_HOST_PORT=3307

# Port API mo ra host. App Flutter dang tro vao 8081.
API_PORT=8081

JWT_SECRET=drink-order-jwt-secret-key-for-btl-min-32-chars
